{
  "name": "@sebald/dither-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Dither UI, a design system for pixel-art games",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": {
      "style": "./src/styles.css",
      "default": "./src/styles.css"
    }
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cva": "1.0.0-beta.12",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/fira-code": "5.3.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
