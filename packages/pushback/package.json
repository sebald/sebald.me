{
  "name": "@sebald/pushback",
  "version": "0.0.0",
  "private": true,
  "description": "Pushback, a pixel-art duel of words in a meeting room",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": {
      "style": "./src/styles.css",
      "default": "./src/styles.css"
    },
    "./lib/*": [
      "./src/lib/*.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "simulate": "node --import tsx src/lib/simulate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sebald/blip-ui": "workspace:*",
    "cva": "1.0.0-beta.12",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
