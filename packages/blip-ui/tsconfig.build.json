{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [],
    "incremental": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/examples/**",
    "src/compositions/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
